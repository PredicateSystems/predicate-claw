# Real Claude Code Demo - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API Key for Claude Code
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Sidecar URL (defaults to localhost:8787)
PREDICATE_SIDECAR_URL=http://localhost:8787

# Optional: Enable verbose logging
SECURECLAW_VERBOSE=true

# Optional: Slow mode for recording demos
DEMO_SLOW_MODE=false
