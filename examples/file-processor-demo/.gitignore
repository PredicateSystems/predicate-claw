.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/

# TypeScript cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

